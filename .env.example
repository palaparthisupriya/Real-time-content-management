# Server Configuration
HOST=0.0.0.0
PORT=8080

# Redis L2 Configuration
REDIS_URL=redis://redis:6379/0

# L1 LRU Cache Configuration
L1_CAPACITY=100

# L2 Redis TTL (seconds)
L2_TTL_SECONDS=30

# Distributed Lock Configuration
LOCK_TIMEOUT_MS=5000
LOCK_RETRY_INTERVAL_MS=100
LOCK_MAX_RETRIES=50

# Oracle Simulation Configuration
ORACLE_DELAY_SECONDS=2.0
