# Environment Variables Configuration
# Copy this file to .env before starting the services with docker-compose up

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=recommendation_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=user_interactions
KAFKA_GROUP_ID=profile-update-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Service Ports
EVENT_INGESTION_PORT=8000
RECOMMENDATION_PORT=8001
